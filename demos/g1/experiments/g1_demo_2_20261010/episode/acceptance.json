{
  "scope": "Child checks for one selected episode, subject to independent parent review. Not a robustness claim.",
  "checks": {
    "complete_no_fall": true,
    "actual_return_within_0_30_m": true,
    "actual_final_heading_within_15_deg_of_reverse": true,
    "walk_forward_more_than_0_4_m": true,
    "wave_repeated_lateral_motion": true,
    "bow_and_recover": true,
    "moving_turn_150_to_210_deg": true,
    "all_four_transitions_supported": true,
    "transition_planted_foot_excursion_under_0_03_m": true,
    "reference_boundaries_no_large_joint_jump": true,
    "final_hold_supported": true,
    "joint_limits": true,
    "torque_limits": true,
    "no_nonfoot_ground_contact": true,
    "full_reproduction_arrays_equal": true
  },
  "thresholds_declared_before_first_episode": {
    "actual_return_m": 0.3,
    "heading_error_deg": 15
  },
  "not_zero_slip_or_perfect_tracking": true
}
